# Process and public origins
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4280
IP_AGENT_CORS_ORIGINS=https://app.example.com
WEB_API_BASE_URL=https://api.example.com

# Pure talking-avatar video. It reuses Media Lab voices, then submits the
# generated narration and portrait through time-limited OSS URLs. Keep both
# credentials server-side and grant only the required visual-generation API.
IP_AGENT_VOLCENGINE_VISUAL_ACCESS_KEY_ID=
IP_AGENT_VOLCENGINE_VISUAL_SECRET_KEY=
IP_AGENT_VOLCENGINE_VISUAL_BASE_URL=https://visual.volcengineapi.com
IP_AGENT_TALKING_PHOTO_DRIVE_MODE=auto
IP_AGENT_TALKING_PHOTO_PRICE_PER_SECOND_CNY=0.3
IP_AGENT_TALKING_PHOTO_ROLE_PRICE_CNY=0.1

# Limit concurrent provider tasks on the API process. Keep this at 2 on the
# current 2 GiB instance; raise it only after moving execution to a worker pool.
IP_AGENT_TASK_CONCURRENCY=2
IP_AGENT_TASK_QUEUE_MAX_PENDING=16

# Use PostgreSQL only after the migration has been verified. Keep json during
# a rollback; the JSON snapshot remains available beside the database state.
IP_AGENT_STORE_DRIVER=json
IP_AGENT_POSTGRES_URL=
IP_AGENT_POSTGRES_POOL_MAX=5

# Optional distributed task limiter. It falls back to the local queue if Redis
# is temporarily unavailable unless IP_AGENT_REDIS_REQUIRED=1.
IP_AGENT_REDIS_URL=
IP_AGENT_REDIS_CONCURRENCY=2
IP_AGENT_REDIS_TASK_LEASE_MS=600000
IP_AGENT_REDIS_ACQUIRE_TIMEOUT_MS=15000
IP_AGENT_REDIS_REQUIRED=0

# Private object storage. Keep the bucket private and allow the Web origin to
# PUT with Content-Type in the OSS CORS policy.
IP_AGENT_STORAGE_DRIVER=oss
ALIYUN_OSS_REGION=oss-cn-shenzhen
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_STS_TOKEN=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_INTERNAL_ENDPOINT=
IP_AGENT_UPLOAD_SIGNING_SECRET=
IP_AGENT_MAX_UPLOAD_BYTES=524288000
IP_AGENT_OSS_UPLOAD_EXPIRES_SECONDS=900
IP_AGENT_OSS_READ_EXPIRES_SECONDS=3600

# Optional CDN. Configure the CDN origin as the private OSS bucket. URL auth
# type A is supported; leave the auth key empty only when CDN URL auth is off.
ALIYUN_CDN_DOMAIN=
ALIYUN_CDN_AUTH_TYPE=a
ALIYUN_CDN_AUTH_KEY=
ALIYUN_CDN_URL_EXPIRES_SECONDS=3600
