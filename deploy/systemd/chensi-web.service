[Unit]
Description=Chensi AI Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chensi
Group=chensi
WorkingDirectory=/opt/chensi-ai-content-os/current
EnvironmentFile=/etc/chensi-ai-content-os/app.env
Environment=NODE_ENV=production
Environment=WEB_HOST=127.0.0.1
Environment=WEB_PORT=4273
Environment=WEB_API_BASE_URL=
ExecStart=/usr/bin/node web/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/chensi-ai-content-os
LimitNOFILE=16384
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
